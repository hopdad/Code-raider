# ─── Code Raider — server environment ───────────────────────────────────────
# Copy to server/.env for local dev (see DEPLOY.md), or set these as
# Variables in your host (Railway injects DATABASE_URL and REDIS_URL for you).

# 'development' or 'production'. Controls CORS, secure cookies, static serving.
NODE_ENV=development

# Port the Express/Socket.io server listens on.
PORT=3001

# Session cookie signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Steam Web API key — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your-steam-api-key

# Public base URL of the server (used for the Steam OpenID return URL).
# Local dev: http://localhost:3001   Prod: https://your-app.up.railway.app
BASE_URL=http://localhost:3001

# Where to send the user after login. Local dev points at the Vite dev server.
# Prod: same origin as BASE_URL.
CLIENT_URL=http://localhost:5173

# Postgres connection string.
# Local docker-compose default:
DATABASE_URL=postgres://dev:dev@localhost:5432/coderaider

# Redis connection string.
REDIS_URL=redis://localhost:6379
